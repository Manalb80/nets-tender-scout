# NETS Presales Engine: Environment Configuration
# Copy this file to .env and fill in your values.

# ── Storage (replaces hardcoded D:\ paths) ──
RFP_STORAGE_PATH=./data/rfps
# For production on a server: /opt/nets/rfps
# For SharePoint mounted drive: /mnt/sharepoint/rfps

# ── OCR (scanned PDF text extraction) ──
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=50
# Requires: pip install pdf2image pytesseract
# And Tesseract installed: apt install tesseract-ocr (Linux) or brew install tesseract (Mac)

# ── Playwright (headless browser for login-walled portals) ──
PLAYWRIGHT_HEADLESS=true
# Requires: pip install playwright && playwright install chromium

# ── SharePoint (Microsoft Graph API) ──
SHAREPOINT_TENANT=netsinternational
SHAREPOINT_SITE_ID=your-site-id-here
SHAREPOINT_DRIVE_ID=your-drive-id-here
SHAREPOINT_RFP_ROOT=Digitisation/NETS_Discovery_Incoming/RFPs
SHAREPOINT_UPLOAD=false
# Set to true once Graph API write access is granted

# ── Agent 1b: RFP intake (scripts/run_rfp_fetch.py) ──
# Default: scan the OneDrive-synced copy of the SharePoint RFP folder (or a staging folder). No Azure app needed.
RFP_SOURCE=local
RFP_WATCH_DIR=C:/Users/you/OneDrive - Company/NETS-Karachi Presales-Technical Proposals/RFP
RFP_ARCHIVE_DIR=C:/NETS/rfp-archive
# copy keeps originals (use this on the shared synced folder); move only for a private staging folder; off
RFP_ARCHIVE_MODE=copy
RFP_STABLE_SECONDS=30
RFP_RECHECK_SECONDS=2
RFP_CACHE_FILE=rfp_state/agent1b_hashes.json
RFP_RECURSIVE=true
RFP_HYDRATE=false
# SHAREPOINT or AUTO_DOWNLOADED
RFP_ACQ_STATUS=SHAREPOINT
RFP_OUT_DIR=rfp_out
# Later, once IT grants an app registration: RFP_SOURCE=graph plus
# SHAREPOINT_RFP_ITEM_ID=your-rfp-folder-item-id (with SHAREPOINT_DRIVE_ID above), or SHAREPOINT_RFP_SHARE_URL=https://...
# SHAREPOINT_RFP_RECURSIVE=false
# Optional local copy of each Graph download: RFP_DOWNLOAD_DIR=./data/rfps
# For a quick Graph test instead of the app registration below: GRAPH_ACCESS_TOKEN=...

# ── Azure AD (only for RFP_SOURCE=graph, later) ──
# App-only needs the Graph application permission Files.Read.All (or Sites.Read.All) with admin consent.
GRAPH_TENANT_ID=your-azure-tenant-id
GRAPH_CLIENT_ID=your-app-registration-client-id
GRAPH_CLIENT_SECRET=your-app-registration-client-secret

# ── Database ──
# For Firestore:
GOOGLE_APPLICATION_CREDENTIALS=./credentials/firestore-key.json
# For PostgreSQL (future):
# DATABASE_URL=postgresql://user:pass@host:5432/nets_presales

# ── AI (Claude API for analysis workers) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Manager Agent ──
# MGR_POLL_INTERVAL=300  # seconds between polling cycles (default 300)
# MGR_MAX_RETRIES=3      # retries before escalation
