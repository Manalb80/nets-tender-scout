# NETS Presales Engine: Environment Configuration
# Copy this file to .env and fill in your values.

# ── Storage (replaces hardcoded D:\ paths) ──
RFP_STORAGE_PATH=./data/rfps
# For production on a server: /opt/nets/rfps
# For SharePoint mounted drive: /mnt/sharepoint/rfps

# ── OCR (scanned PDF text extraction) ──
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=50
# Requires: pip install pdf2image pytesseract
# And Tesseract installed: apt install tesseract-ocr (Linux) or brew install tesseract (Mac)

# ── Playwright (headless browser for login-walled portals) ──
PLAYWRIGHT_HEADLESS=true
# Requires: pip install playwright && playwright install chromium

# ── SharePoint (Microsoft Graph API) ──
SHAREPOINT_TENANT=netsinternational
SHAREPOINT_SITE_ID=your-site-id-here
SHAREPOINT_DRIVE_ID=your-drive-id-here
SHAREPOINT_RFP_ROOT=Digitisation/NETS_Discovery_Incoming/RFPs
SHAREPOINT_UPLOAD=false
# Set to true once Graph API write access is granted

# ── Azure AD (for SharePoint Graph API authentication) ──
GRAPH_TENANT_ID=your-azure-tenant-id
GRAPH_CLIENT_ID=your-app-registration-client-id
GRAPH_CLIENT_SECRET=your-app-registration-client-secret

# ── Database ──
# For Firestore:
GOOGLE_APPLICATION_CREDENTIALS=./credentials/firestore-key.json
# For PostgreSQL (future):
# DATABASE_URL=postgresql://user:pass@host:5432/nets_presales

# ── AI (Claude API for analysis workers) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Manager Agent ──
# MGR_POLL_INTERVAL=300  # seconds between polling cycles (default 300)
# MGR_MAX_RETRIES=3      # retries before escalation
